# Example environment overrides for Docker Compose.
#
# Copy and adapt for your deployment:
#   cp example.env .env
#
# Docker Compose loads .env automatically from this directory.
# When set, these values override secrets stored in updater.conf at runtime.
#
# Non-secret settings (Omada URL, site ID, domains, update interval, etc.)
# can still be configured via the Web UI and are stored in the data volume.
#
# WEB_USERNAME must be set in updater.conf (via the Web UI) for Basic Auth.
# Only the password can be overridden here via WEB_PASSWORD.

OMADA_CLIENT_SECRET=your-omada-client-secret
DUCKDNS_TOKEN=your-duckdns-token
WEB_PASSWORD=your-web-ui-password
